# Copy to .env before running `docker compose up`
DATABASE_URL=postgres://fintech:fintech@localhost:5432/fintech_network
PORT=3000
NODE_ENV=development
# Branding is configurable — never hard-code a brand name into app logic.
APP_NAME=FinTech Network

# Dev-only secret. Generate a real one per environment before any real
# deployment — never reuse this value outside a local sandbox.
JWT_SECRET=dev-only-change-me

# Which app origins this deployment serves. Required in production,
# where the API refuses to start without it (and refuses a wildcard or a
# plain-http origin). Locally it defaults to the app shells and the two
# ports the end-to-end tests use.
# ALLOWED_ORIGINS=https://app.example.com,https://till.example.com

# Adds the Secure flag to the session cookie. Always on in production;
# set it for a staging deployment served over https.
# SECURE_COOKIES=true

# Number of proxies in front of the API (a load balancer is 1). Leave
# unset when nothing is: it decides whose address the rate limits count.
# TRUST_PROXY_HOPS=1

# Optional rate limits (requests per minute per client).
# RATE_LIMIT_PER_MINUTE=100
# AUTH_RATE_LIMIT_PER_MINUTE=10
# WRITE_RATE_LIMIT_PER_MINUTE=30

# Security settings (Phase 14). See docs/security/README.md.
# How long a started payment may sit on the review screen.
# PAYMENT_APPROVAL_TTL_MINUTES=15
# Failed sign-ins for one account, per window, before it's held off.
# LOGIN_FAILURE_LIMIT=10
# LOGIN_FAILURE_WINDOW_MINUTES=15
# Unknown recipient addresses one payer may name per hour.
# RECIPIENT_LOOKUP_FAILURE_LIMIT=10
