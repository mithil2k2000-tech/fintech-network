# Serving one of the apps (Phase 16).
#
# Two things this has to get right. The apps are single-page apps, so
# any path that isn't a file has to return index.html — otherwise a
# refresh on /activity is a 404. And /api has to be forwarded from the
# same origin, because the session is a SameSite=Strict cookie: put the
# API on another origin and the browser stops sending it.

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Built assets are content-hashed, so they can be cached hard.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # index.html never is: it's how a new version reaches anyone.
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  # ${API_UPSTREAM} is filled in at start-up by the nginx image's own
  # envsubst step. nginx's own $variables below are lowercase and stay
  # untouched, because only names that exist in the environment are
  # substituted.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
