# especially: it is the largest thing in the repo and the image installs
# its own anyway.
node_modules
**/node_modules
**/dist
**/.vite
**/test-results
**/playwright-report
.git
.github
.env
.env.*
!.env.example
docs
*.log
# Terraform downloads its providers (hundreds of MB) next to the code.
infra/terraform
